<?xml version="1.0"?>
<package format="3">
  <name>whill_nav2_bringup</name>
  <version>0.0.1</version>
  <description>WHILL Nav2 bringup package</description>
  <maintainer email="ed26002@nda.ac.jp">selab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- ROS 2 Messages and TF -->
  <exec_depend>rclpy</exec_depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Python Libraries -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Localization -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <!-- 3D Submap Localization -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>pcl_conversions</depend>
  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>
  <exec_depend>nav2_map_server</exec_depend>

  <!-- Navigation -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <!-- WHILL Hardware and Control -->
  <exec_depend>whill_bringup</exec_depend>
  <exec_depend>urg_node2</exec_depend>

  <!-- System Status Announcer -->
  <exec_depend>whill_msgs</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
